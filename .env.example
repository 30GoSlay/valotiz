# Copie ce fichier en .env si tu veux RÉGÉNÉRER les avatars (pas nécessaire pour jouer).
#   cp .env.example .env
# Puis :  node avatars/gen.mjs 18

# LIB : dossier new_lib OU URL de la bibliothèque SWF (obligatoire pour la génération)
LIB=https://01static.chapatiz.com/fr/swf/new_lib/

# CATALOG : items.json pour des tenues variées (optionnel ; sinon avatars de base unis)
CATALOG=./items.json
